{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/review.mjs": {
      "includeFiles": "content/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/batches", "destination": "/api/review?route=batches" },
    { "source": "/api/batch/:id", "destination": "/api/review?route=batch&id=:id" },
    { "source": "/api/admin/:id", "destination": "/api/review?route=admin&id=:id" },
    { "source": "/api/labels/:batch/:rater", "destination": "/api/review?route=labels&batch=:batch&rater=:rater" },
    { "source": "/api/export", "destination": "/api/review?route=export" },
    { "source": "/results", "destination": "/api/review?route=results" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
